# Renomeie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env com dados reais no repositório.
#
# No GitHub Actions, cadastre cada variável abaixo em:
#   Settings > Secrets and variables > Actions > Repository secrets
# e injete no workflow com:
#   env:
#     SECRET_KEY:                           ${{ secrets.SECRET_KEY }}
#     SECRET_ALGORITHM:                     ${{ secrets.SECRET_ALGORITHM }}
#     SECRET_ACCESS_TOKEN_EXPIRATION_MINUTES: ${{ secrets.SECRET_ACCESS_TOKEN_EXPIRATION_MINUTES }}
#     SECRET_DATABASE_URL:                  ${{ secrets.SECRET_DATABASE_URL }}
#     SECRET_MQTT_BROKER:                   ${{ secrets.SECRET_MQTT_BROKER }}
#     SECRET_MQTT_PORT:                     ${{ secrets.SECRET_MQTT_PORT }}
#     SECRET_MQTT_USERNAME:                 ${{ secrets.SECRET_MQTT_USERNAME }}
#     SECRET_MQTT_PASSWORD:                 ${{ secrets.SECRET_MQTT_PASSWORD }}

# Segurança JWT
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY = "TROQUE-POR-UMA-CHAVE-LONGA-E-ALEATORIA"
SECRET_ALGORITHM = "HS256"
SECRET_ACCESS_TOKEN_EXPIRATION_MINUTES = "30"

# Banco de dados PostgreSQL
SECRET_DATABASE_URL = "postgresql://usuario:SENHA@localhost:5432/elderguard_db"

# Broker MQTT
SECRET_MQTT_BROKER = "seu-broker.exemplo.com"
SECRET_MQTT_PORT = "1883"
SECRET_MQTT_USERNAME = "seu-usuario-mqtt"
SECRET_MQTT_PASSWORD = "sua-senha-mqtt"
